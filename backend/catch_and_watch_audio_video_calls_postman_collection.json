{
	"info": {
		"_postman_id": "c8e9d0a1-4b2c-4d3e-9f1a-2b3c4d5e6f7a",
		"name": "Catch & Watch - Audio & Video Calling APIs",
		"description": "Postman Collection for Catch & Watch 1-to-1 Audio & Video Calling Module powered by Agora RTC and Socket.IO.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5000/api",
			"type": "string"
		},
		{
			"key": "token",
			"value": "YOUR_JWT_AUTH_TOKEN",
			"type": "string"
		},
		{
			"key": "receiverId",
			"value": "RECEIVER_USER_ID",
			"type": "string"
		},
		{
			"key": "callId",
			"value": "CALL_ID",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Start Call (Audio / Video)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"receiverId\": \"{{receiverId}}\",\n  \"type\": \"video\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/calls",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"calls"
					]
				},
				"description": "Initiate a 1-to-1 audio or video call with a target user."
			},
			"response": []
		},
		{
			"name": "2. Get Call History",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/calls/history?page=1&limit=20",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"calls",
						"history"
					],
					"query": [
						{
							"key": "page",
							"value": "1"
						},
						{
							"key": "limit",
							"value": "20"
						}
					]
				},
				"description": "Fetch user's call history with pagination."
			},
			"response": []
		},
		{
			"name": "3. Get Call Details by ID",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/calls/{{callId}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"calls",
						"{{callId}}"
					]
				},
				"description": "Fetch single call details including populated caller and receiver info."
			},
			"response": []
		},
		{
			"name": "4. Accept Call",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/calls/{{callId}}/accept",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"calls",
						"{{callId}}",
						"accept"
					]
				},
				"description": "Accept an incoming call (returns Agora RTC token for receiver)."
			},
			"response": []
		},
		{
			"name": "5. Reject Call",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/calls/{{callId}}/reject",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"calls",
						"{{callId}}",
						"reject"
					]
				},
				"description": "Decline/reject an incoming call."
			},
			"response": []
		},
		{
			"name": "6. Mark Call as Busy",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/calls/{{callId}}/busy",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"calls",
						"{{callId}}",
						"busy"
					]
				},
				"description": "Mark incoming call as busy when user is already in another call."
			},
			"response": []
		},
		{
			"name": "7. Cancel Outgoing Call",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/calls/{{callId}}/cancel",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"calls",
						"{{callId}}",
						"cancel"
					]
				},
				"description": "Cancel an outgoing ringing call before recipient answers."
			},
			"response": []
		},
		{
			"name": "8. Mark Call as Missed",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/calls/{{callId}}/missed",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"calls",
						"{{callId}}",
						"missed"
					]
				},
				"description": "Mark call as missed upon timeout."
			},
			"response": []
		},
		{
			"name": "9. End Call",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/calls/{{callId}}/end",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"calls",
						"{{callId}}",
						"end"
					]
				},
				"description": "End an ongoing connected call and calculate duration."
			},
			"response": []
		},
		{
			"name": "10. Get Agora RTC Token for Call",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/calls/{{callId}}/token",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"calls",
						"{{callId}}",
						"token"
					]
				},
				"description": "Fetch a fresh Agora RTC token for a call participant."
			},
			"response": []
		}
	]
}
